# For local development or running with an external OpenAI-compatible instance.
MANAGER_MODE=external
CHAT_EINFRA_URL=https://llm.ai.e-infra.cz/v1
CHAT_EINFRA_KEY=sk-your-key-here
# Alternatively, read the key from a file (takes precedence over CHAT_EINFRA_KEY):
# CHAT_EINFRA_KEY_FILE=/run/secrets/einfra_api_key
MODEL_NAME=mini
APP_PASSWORD=my_secure_password
JWT_SECRET=super_secret_for_tokens
DB_PATH=jailbreaking.db
